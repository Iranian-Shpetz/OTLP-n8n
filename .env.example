# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OTLP_AUTH_TOKEN=

# Choose a unique ntfy topic. Public ntfy.sh topics are not private.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
# Optional bearer token for an authenticated ntfy server.
NTFY_TOKEN=

# The default only accepts connections from this machine.
OTLP_BIND_ADDRESS=127.0.0.1
OTLP_HTTP_PORT=4318
